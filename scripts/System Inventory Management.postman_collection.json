				{
					"name": "POST login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// 1. Parsea (convierte) la respuesta JSON en un objeto\r",
									"var jsonData = pm.response.json();\r",
									"\r",
									"// 2. Extrae el token de la respuesta\r",
									"// (Ajusta \"token\" si tu propiedad se llama diferente, ej: \"access_token\")\r",
									"var token = jsonData.token;\r",
									"\r",
									"// 3. Guarda el token en una variable de ENTORNO\r",
									"// ¡Asegúrate de tener un Entorno activo seleccionado en Postman!\r",
									"pm.environment.set(\"AUTH_TOKEN\", token);\r",
									"\r",
									"// OPCIONAL: También puedes guardarlo en variables de COLECCIÓN\r",
									"// pm.collectionVariables.set(\"AUTH_TOKEN\", token);"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
